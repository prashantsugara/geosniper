# Optional. Copy to Growth/.env locally; never share or commit it.
# Export packs work without any credentials. Restart Growth Studio after editing.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Instagram adapter uses Facebook Login + an Instagram Business account linked to a Page.
INSTAGRAM_USER_ID=
META_ACCESS_TOKEN=
# Set the supported version shown in your Meta app dashboard (example format: vNN.0).
META_API_VERSION=
# Optional override; local installed FFmpeg is auto-detected by default.
PROMO_FFMPEG=
